[Unit]
Description=AjaxCMS Multi-Site Server
Documentation=https://github.com/bhoult/AjaxCMS
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/AjaxCMS
Environment=NODE_ENV=production
Environment=SITES_DIR=./sites
Environment=ENABLE_SSL=true
Environment=MAINTAINER_EMAIL=admin@example.com
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=ajaxcms

# Allow binding to privileged ports (80, 443)
AmbientCapabilities=CAP_NET_BIND_SERVICE

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/AjaxCMS/sites

[Install]
WantedBy=multi-user.target
