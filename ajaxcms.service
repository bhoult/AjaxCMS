[Unit]
Description=AjaxCMS Multi-Site Server
Documentation=https://github.com/bhoult/AjaxCMS
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/var/www/AjaxCMS
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=SITES_DIR=./sites
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=ajaxcms

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/www/AjaxCMS/sites

[Install]
WantedBy=multi-user.target
