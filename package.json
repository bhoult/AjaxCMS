{
  "name": "ajaxcms-server",
  "version": "1.0.0",
  "description": "Multi-site Node.js web server for AjaxCMS with JSON directory listings",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [
    "cms",
    "ajax",
    "static-site"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/sites/"
    ],
    "testMatch": [
      "**/__tests__/**/*.spec.js"
    ]
  }
}
