{
  "name": "ajaxcms-server",
  "version": "1.0.0",
  "description": "Multi-site Node.js web server for AjaxCMS with JSON directory listings",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "node --experimental-vm-modules node_modules/.bin/jest",
    "test:watch": "node --experimental-vm-modules node_modules/.bin/jest --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/.bin/jest --coverage"
  },
  "keywords": [
    "cms",
    "ajax",
    "static-site"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bootstrap": "^5.3.8",
    "express": "^4.18.2",
    "greenlock-express": "^4.0.3",
    "jquery-ui-dist": "^1.13.3",
    "marked": "^16.4.1",
    "segment-js": "^1.1.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "jquery": "^3.7.1",
    "jsdom": "^27.1.0",
    "nodemon": "^3.0.1",
    "puppeteer": "^24.27.0",
    "supertest": "^6.3.3"
  },
  "jest": {
    "testEnvironment": "node",
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/sites/"
    ],
    "testMatch": [
      "**/__tests__/**/*.spec.js"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(jsdom|parse5|entities|whatwg-url|saxes)/)"
    ]
  }
}
